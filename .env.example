# Vigil Server Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in values before running `docker compose up -d`.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Django ────────────────────────────────────────────────────────────────────

# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key

# Set to false in production.
DJANGO_DEBUG=false

# Comma-separated list of hostnames/IPs the server accepts requests for.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins trusted for unsafe (POST) requests — scheme included.
# Needed when Vigil is served under an external hostname or behind a reverse
# proxy; without it Django rejects logins and every POST with "Origin checking
# failed". Setting VIGIL_PUBLIC_URL below covers the common single-hostname case
# automatically, so you only need this for additional origins.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://vigil.example.com,https://vigil.kingdom.local

# Optional: set to the public URL for proper absolute URLs in emails/links.
# DJANGO_SITE_URL=https://vigil.example.com

# Largest request body the server accepts, in bytes. Default 8388608 (8 MB).
# Task results are the large payload — a Trivy scan report. Django enforces this
# before any view runs, so a result over the limit fails the whole POST with a
# bare 400 that nothing can annotate and the task stays DISPATCHED forever.
# Raise it only if you see that; a proxy in front of Vigil needs a matching
# body limit of its own.
# VIGIL_MAX_REQUEST_BODY_BYTES=8388608


# ── No longer used ────────────────────────────────────────────────────────────
#
# VIGIL_AGENT_VERSION — ignored since 2026.6.2. The expected agent version is
# detected from the agent bundled in the build, so there is nothing to keep in
# lockstep with each release. Leaving it set is harmless; the server logs a note
# at startup naming both the value you set and the one actually in use.

# ── Remote access (Cloudflare Tunnel / Tailscale / reverse proxy) ─────────────
# See docs/REMOTE-ACCESS.md. Set the external URL Vigil is reached at; its host
# and origin are added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS automatically.
# VIGIL_PUBLIC_URL=https://vigil.example.com
# Trust X-Forwarded-Proto/Host from a TLS-terminating proxy/tunnel. Only enable
# when that proxy is the ONLY route to Vigil (see the security note in the doc).
# VIGIL_TRUST_PROXY=false
# Set true once serving over HTTPS so session/CSRF cookies are marked Secure.
# VIGIL_SECURE_COOKIES=false
# Cloudflare Tunnel token, used by `docker compose --profile tunnel up`.
# TUNNEL_TOKEN=


# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_DB=vigil
POSTGRES_USER=vigil
# Use a strong random password in production.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ── Redis / Celery ────────────────────────────────────────────────────────────

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ── Task Signing ──────────────────────────────────────────────────────────────
#
# Ed25519 signing key seed — base64-encoded 32 random bytes (44 chars, ending
# in '='). Every task dispatched to agents is signed with this key; agents
# verify signatures before executing. Rotate only during a maintenance window
# (every enrolled agent will need to delete its server_public_key.pin and
# re-pin the new key).
#
# Generate:
#   python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
#
# Verify the value you pasted is valid base64 of 32 bytes:
#   python3 -c "import base64,sys; print(len(base64.b64decode(sys.argv[1])))" "<paste-seed-here>"
#   # Expect: 32
#
# IMPORTANT — Portainer / YAML stack editors: do NOT inline the seed into
# docker-compose.yml as a bare value. The trailing '=' is base64 padding and
# is silently stripped by some YAML parsers. Either:
#   (a) set it via Portainer's "Environment variables" tab, or
#   (b) wrap the value in double quotes when pasted into YAML.
# A malformed seed throws binascii.Error: Incorrect padding inside
# get_signing_key() and 500s every checkin in the fleet.
VIGIL_SIGNING_KEY_SEED=


# ── Email (optional) ──────────────────────────────────────────────────────────
#
# Used for alert notifications and password reset emails.
# Leave blank to disable email sending.
#
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=vigil@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Vigil <vigil@example.com>
