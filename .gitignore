CLAUDE.md
.claude/
.idea/
.env
__pycache__/
*.pyc
*.pyo
db.sqlite3
db.sqlite3.bak.*

# Bundled agent binaries. The server serves whatever is in here, and CI builds
# them per-platform — they are release artifacts, not source. Left untracked,
# a local PyInstaller build drops ~14MB per platform straight into a commit.
server/agent_dist/
staticfiles/
*.egg-info/
.venv/

.worktrees/

# Superpowers tooling artifacts — design docs belong directly under docs/
docs/superpowers/

# Internal working notes — point-in-time audits, scratch specs, and
# planning docs. Kept locally for reference, never committed (keeps the
# public repo to shipped code + user-facing docs).
docs/internal/

# Session-state buffer for the assistant — never code, never committed.
.remember/

# Agent runtime — never commit live credentials or state
agent/agent.yml
agent/data/

# Visual brainstorming companion — local scratch, never committed
.superpowers/
REXYMCP.md
.rexymcp/
docs/dev/

# Test artifacts: the agent_dist suite writes an uploaded binary here on every
# run, so the directory fills with junk that is runtime upload, not source.
# The two fixtures already tracked are kept with a negation so this rule
# cannot silently untrack them.
server/media/agent_binaries/*
!server/media/agent_binaries/binary
!server/media/agent_binaries/binary_LexSWBw

# Local development settings. A real Ed25519 signing seed was committed here
# once; the file generates its own into settings_local_secret.py now, and
# neither belongs in git.
server/vigil/settings_local.py
server/vigil/settings_local_secret.py

# rexymcp executor scratch
.scratch/
